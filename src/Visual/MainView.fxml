<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Visual.MainController">

    <!-- 🔝 BARRA SUPERIOR -->
    <top>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10; -fx-background-color: #DDE3EA;">

            <ComboBox fx:id="comboOrigen" promptText="Origen" prefWidth="150"/>
            <ComboBox fx:id="comboDestino" promptText="Destino" prefWidth="150"/>

            <ComboBox fx:id="comboCriterio" prefWidth="140"/>
            <ComboBox fx:id="comboAlgoritmo" prefWidth="160"/>

            <Button text="Buscar ruta"
                    onAction="#buscarRuta"
                    style="-fx-background-color: #0F1C3F; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <!-- 🔥 BOTÓN NUEVO -->
            <Button text="Agregar parada"
                    onAction="#agregarParada"
                    style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;"/>

        </HBox>
    </top>

    <!-- 🗺️ MAPA -->
    <center>
        <StackPane fx:id="contenedorMapa"
                   minHeight="450"
                   prefHeight="550"
                   style="-fx-background-color: #E3F2FD;"/>
    </center>

    <!-- 📊 RESULTADOS -->
    <bottom>
        <VBox spacing="10" style="-fx-padding: 10;">

            <TextArea fx:id="areaResultado"
                      prefHeight="140"
                      wrapText="true"/>

            <!-- Leyenda de rutas -->
            <HBox fx:id="leyendaRutas" spacing="15" alignment="CENTER">
                <Label text="Ruta principal" style="-fx-text-fill: blue;"/>
                <Label text="Tiempo" style="-fx-text-fill: green;"/>
                <Label text="Costo" style="-fx-text-fill: orange;"/>
                <Label text="Transbordo" style="-fx-text-fill: purple;"/>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>