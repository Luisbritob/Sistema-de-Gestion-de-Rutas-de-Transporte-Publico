<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Visual.MainController"
      spacing="20"
      prefWidth="1200"
      prefHeight="700"
      style="-fx-background-color: #A7B3BF;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>

        <VBox spacing="18"
              prefWidth="320"
              style="-fx-background-color: #0F1C3F; -fx-padding: 20; -fx-background-radius: 12;">

            <children>

                <Label text="ROUTEFINDER"
                       style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" />

                <Label text="OPCIONES"
                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />

                <Button text="RUTAS"
                        onAction="#rutas"
                        prefWidth="260" prefHeight="45"
                        style="-fx-background-color: white; -fx-text-fill: #0F1C3F; -fx-font-size: 16px; -fx-font-weight: bold;" />

                <Button text="PARADAS"
                        onAction="#paradas"
                        prefWidth="260" prefHeight="45"
                        style="-fx-background-color: white; -fx-text-fill: #0F1C3F; -fx-font-size: 16px; -fx-font-weight: bold;" />

                <Button text="VER GRAFO"
                        onAction="#verGrafo"
                        prefWidth="260" prefHeight="45"
                        style="-fx-background-color: white; -fx-text-fill: #0F1C3F; -fx-font-size: 16px; -fx-font-weight: bold;" />

                <Region prefHeight="15"/>

                <Label text="BUSCAR RUTA"
                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />

                <Label text="Origen"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />
                <ComboBox fx:id="comboOrigen" prefWidth="260"/>

                <Label text="Destino"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />
                <ComboBox fx:id="comboDestino" prefWidth="260"/>

                <Label text="Criterio"
                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />
                <ComboBox fx:id="comboCriterio" prefWidth="260"/>

                <Button text="Buscar mejor ruta"
                        onAction="#buscarRuta"
                        prefWidth="260" prefHeight="45"
                        style="-fx-background-color: #63666A; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />

                <TextArea fx:id="areaResultado"
                          prefWidth="260"
                          prefHeight="190"
                          wrapText="true"
                          editable="false"
                          style="-fx-font-size: 13px; -fx-control-inner-background: white;" />

            </children>
        </VBox>

        <VBox spacing="15"
              alignment="TOP_CENTER"
              style="-fx-background-color: #D9DEE5; -fx-padding: 20; -fx-background-radius: 12;"
              HBox.hgrow="ALWAYS">

            <children>

                <Label text="MAPA"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #0F1C3F;" />

                <StackPane fx:id="contenedorMapa"
                           prefWidth="800"
                           prefHeight="620"
                           style="-fx-background-color: white; -fx-border-color: #0F1C3F; -fx-border-width: 3; -fx-background-radius: 8;" />
            </children>
        </VBox>

    </children>
</HBox>